# Auto-detect text files, ensure LF
* text=auto eol=lf

# Explicit text
*.py text diff=python eol=lf
*.pyi text diff=python eol=lf
*.md text diff=markdown eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.sql text eol=lf
*.txt text eol=lf

# Binary
*.parquet binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
